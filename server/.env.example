PORT=3001
DB_PATH=./kollect.db

# --- Auth ---
# Local dev only: bypass Azure Easy Auth so `npm run dev` works without Azure in
# front. Inert on Azure (gated on WEBSITE_SITE_NAME). NEVER set on Azure.
AUTH_DEV_BYPASS=true
# Email the dev bypass signs you in as (must be on an allowed domain).
AUTH_DEV_EMAIL=dev@kollect.com.co

# Optional overrides (defaults are baked into server/src/auth.ts):
# Comma-separated list of allowed email domains.
# AUTH_ALLOWED_DOMAINS=kollect.com.co,legalcollection.co,legalforcegroup.com
# Comma-separated emails that get the 'admin' role (everyone else is 'abogado').
# AUTH_ADMIN_EMAILS=you@kollect.com.co
# Comma-separated individual emails allowed IN ADDITION to the allowed domains
# (e.g. an external developer on a personal Gmail). Does NOT open the domain.
# AUTH_ALLOWED_EMAILS=andres.fesugo@gmail.com
